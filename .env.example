# =====================================================================
# Digital M — configuration & keys
# Copy this file to `.env.local` and fill in the values there.
# `.env.local` is gitignored and is the ONLY place real secrets live.
# After changing server-side values, restart the app to pick them up.
# =====================================================================

# ---- Site ----------------------------------------------------------
# Public base URL. Staging: https://d3v.digitalm.eu  Production: https://digitalm.eu
# (Changing this is build-time: rebuild after editing.)
NEXT_PUBLIC_SITE_URL=https://d3v.digitalm.eu

# ---- Contact form (SMTP) ------------------------------------------
# SMTP credentials for the mailbox that sends contact-form email.
# Leave SMTP_HOST blank and the form gracefully falls back to a
# prefilled "email us directly" link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
CONTACT_FORM_TO=contact@digitalm.eu
CONTACT_FORM_FROM=contact@digitalm.eu

# ---- AI assistant (on-site chat — OpenAI, matches CAFRO) ----------
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-4.1-mini
AI_DEFAULT_PROVIDER_PUBLIC=openai
AI_DEFAULT_PROVIDER_MEMBER=openai

# ---- Facebook Messenger bot (same brain as on-site chat; reuses OPENAI_API_KEY) ----
# Custom Messenger bot at /api/messenger. Requires a healthy Meta account:
#   1. Meta for Developers → create app → add the "Messenger" product.
#   2. Generate a Page access token for the Digital M Page → MESSENGER_PAGE_TOKEN.
#   3. App Settings → copy the App Secret → MESSENGER_APP_SECRET (verifies webhook signatures).
#   4. MESSENGER_VERIFY_TOKEN: any random string; enter the same value in the Meta
#      webhook config. Webhook URL: https://digitalm.eu/api/messenger (subscribe to "messages").
#   5. App review for the pages_messaging permission to serve non-admins.
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_TOKEN=
MESSENGER_APP_SECRET=

# ---- Analytics (optional, cookieless — leave blank to disable) -----
# Rebuild after changing (NEXT_PUBLIC_* are build-time). Cookieless = no consent gate.
#   Plausible:  SRC=https://plausible.io/js/script.js   DOMAIN=digitalm.eu
#   Umami:      SRC=https://<your-umami>/script.js       ID=<website-id>
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_ID=

# ---- ChatGPT Ads conversions (optional, server-side only) ---------
# Ads Manager → Conversions → create a Pixel ID + Conversions API key.
# Diagnostic completions (lead_created) and bookings (appointment_scheduled)
# are reported only for visitors who landed from a ChatGPT ad (?oppref=…).
# Leave blank to disable. No browser pixel, no CSP change.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_CAPI_KEY=

# ---- Booking (Google Calendar via a service account) --------------
# Server-side only. Create a Google Cloud service account, enable the
# Calendar API, grant it domain-wide delegation for the Calendar scope in
# the Workspace admin console, and point here. Leave GOOGLE_CALENDAR_KEY_FILE
# blank → the booking widget falls back to "propose a time → emails contact@".
GOOGLE_CALENDAR_KEY_FILE=
# Or inline the key JSON instead of a file path:
# GOOGLE_CALENDAR_KEY_JSON=
BOOKING_CALENDAR_ID=contact@digitalm.eu
BOOKING_IMPERSONATE=contact@digitalm.eu
# Optional: BOOKING_TZ (Europe/Paris), BOOKING_START_HOUR (9), BOOKING_END_HOUR (18),
# BOOKING_SLOT_MIN (30), BOOKING_BUFFER_MIN (30 — gap after each slot), BOOKING_DAYS (14), BOOKING_LEAD_MIN (120)

# Cloudflare Turnstile (diagnostic form anti-spam)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# SQLite enquiries DB (outside deploy tree)
ENQUIRIES_DB_PATH=/home/hermes/data/enquiries.db

# =====================================================================
# Admin CRM (lead-gen) — docs/leadgen-build-spec.md, Appendix B.
# Each module documents its own keys under its marker; keep the order.
# =====================================================================

# @@crm:foundation
# scrypt hash of the shared admin password, "scrypt$16384$8$1$<saltB64>$<hashB64>".
# Produce it on the box: `node scripts/crm-hash-password.js` (reads the password
# from stdin, never from argv). Login stays disabled while unset.
ADMIN_PASSWORD_HASH=
# HMAC-SHA256 key for the dm_admin cookie; >= 32 random bytes hex
# (`openssl rand -hex 32`). Rotating it logs everyone out.
ADMIN_SESSION_SECRET=
# Integer baked into the cookie signature; bump to invalidate every session.
ADMIN_SESSION_VERSION=1
# on|off — in-app job runner (audits) started from src/instrumentation.ts.
CRM_JOB_RUNNER=on

# @@crm:inbox
# No new keys. The inbox reuses LEAD_TELEGRAM (set to "off" to silence every
# Telegram ping, the CRM ones included) and ENQUIRIES_DB_PATH (leads and
# activities live in the same SQLite file). The 08:00 digest reads the same
# path: `node /home/hermes/workspace/scripts/digitalm-digest.js [--db PATH] [--telegram]`.

# @@crm:finder
# Overpass API endpoint (https only; public instance limits: 1 req/s, cache 24 h).
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Second Overpass server used when the first is busy (429/503/504/timeout; Retry-After honoured). "off" disables it.
OVERPASS_FALLBACK_URL=https://z.overpass-api.de/api/interpreter
# Nominatim base URL (1 req/s, identifying User-Agent, cache 30 d, area-level lookups only).
NOMINATIM_URL=https://nominatim.openstreetmap.org
# API Recherche d'entreprises base URL (<= 5 req/s, cache 24 h).
FR_REGISTER_URL=https://recherche-entreprises.api.gouv.fr
# Optional UK Companies House API key; the adapter and GB register re-checks are off when blank.
COMPANIES_HOUSE_KEY=
# on|off — Google Places adapter and "Find on Google" (stub returning [] while off).
GOOGLE_PLACES=off
# Places API key (only read when GOOGLE_PLACES=on).
GOOGLE_PLACES_KEY=
# Hard stop for Places calls per calendar month.
GOOGLE_PLACES_MONTHLY_CAP=900
# Finder (docs/finder-ux-spec.md §2.5): merged rows per search, OpenStreetMap units per search, wall-clock limit (ms).
FIND_MAX_ROWS=2000
FIND_MAX_UNITS=200
FIND_MAX_MS=600000
# Prospects with latest_score below this appear in the "ready to send" view.
READY_SCORE_MAX=60

# @@crm:audit
# Maximum audits per day; extra jobs are re-scheduled to 06:00 Europe/Paris next day.
AUDIT_DAILY_CAP=50
# Optional Google PageSpeed Insights key. Blank = keyless endpoint.
PAGESPEED_API_KEY=
# PSI base URL (override only for tests; read once at boot, https only).
PAGESPEED_URL=https://www.googleapis.com/pagespeedonline/v5/runPagespeed
# User-Agent of our crawler on prospect sites (robots.txt honoured under the
# "DigitalM-AuditBot" token). Blank = the default below.
CRAWLER_USER_AGENT=DigitalM-AuditBot/1.0 (+https://digitalm.eu/fr/legal/mentions-legales; contact@digitalm.eu)

# @@crm:report
# Model for outreach drafts via generateObject (reuses OPENAI_API_KEY; with the
# key blank every draft is the FR/EN template, marked "fallback").
OPENAI_MODEL_DRAFTS=gpt-4.1-mini
# Days a /r/[token] report stays readable after the first send (views are only
# logged once a report has been sent).
REPORT_TTL_DAYS=90

# @@crm:outreach
# Sender address for outreach emails; falls back to CONTACT_FORM_FROM. Must be
# the SMTP user or a verified send-as alias (SPF/DKIM/DMARC checked for it).
OUTREACH_FROM=
# Display name on outreach drafts and emails (Radu's recorded decision).
OUTREACH_FROM_NAME=Radu — Digital M
# Reply-To for outreach emails; also the mailto target in List-Unsubscribe. Defaults to OUTREACH_FROM.
OUTREACH_REPLY_TO=
# Maximum in-app outreach emails per Europe/Paris day; settings.outreach_daily_cap_override can only lower it.
OUTREACH_DAILY_CAP=10
# Comma list of ISO2 countries allowed to receive in-app email. Restrict-only: a
# country is emailable only when its SendRule allows email AND it is listed
# (adding CA does nothing until a CA rule exists).
OUTREACH_COUNTRY_ALLOW=FR,GB,US
# Existing key: "off" silences every Telegram ping, the CRM ones included (unset = on).
LEAD_TELEGRAM=
